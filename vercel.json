
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "dest": "/participant-site/index.html"
    },
    {
      "src": "^/facilitator$",
      "status": 308,
      "headers": {
        "Location": "/facilitator/"
      }
    },
    {
      "src": "^/facilitator/(.*)$",
      "dest": "/facilitator-site/$1"
    }
  ]
}
